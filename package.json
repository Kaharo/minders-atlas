{
  "name": "minders-atlas",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/bundle-api.mjs && vercel dev --listen 3000",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/bundle-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "data:check": "node scripts/validate-data.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:local": "node scripts/migrate.mjs && node scripts/seed.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": { "node": "24.x" }
}
